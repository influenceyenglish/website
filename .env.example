# TEMPLATE ONLY: Next.js does not load .env.example.
# Copy to .env.local for local use. Never commit credentials.
# .env.local contains the active values; define each variable only once.

# LOCAL / DEMO: Razorpay Test Mode (no real payments).
APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
RAZORPAY_MODE=test
RAZORPAY_ENABLE_LIVE=false
RAZORPAY_KEY_ID=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Test plans: monthly INR 49900 paise; yearly INR 499900 paise; interval 1.
RAZORPAY_PLAN_MONTHLY=
RAZORPAY_PLAN_YEARLY=

# Server-only Postgres URL for Supabase project wfjqlubdrnqdhfnifgwd.
# Vercel: copy Supabase Connect > Transaction pooler (port 6543), with TLS.
# postgresql://postgres.wfjqlubdrnqdhfnifgwd:[ENCODED_PASSWORD]@[POOLER_HOST]:6543/postgres?sslmode=require
DATABASE_URL=

# LIVE LATER: replace active values above; do not append duplicate definitions.
# Vercel: set these in the Production environment and redeploy.
# APP_URL and NEXT_PUBLIC_SITE_URL: the same HTTPS production origin.
# RAZORPAY_MODE: live; RAZORPAY_ENABLE_LIVE: true.
# Both key IDs: the same rzp_live_... ID; API secret: its matching live secret.
# Webhook secret and monthly/yearly plan IDs: matching LIVE values.
# Keep Development/Preview on Test Mode. Restart local dev after env edits.
# Optional business overrides and previous-webhook-secret settings are omitted;
# their existing application defaults still apply.

# Internal billing failure emails only. Add your Resend key locally.
RESEND_API_KEY=
# This sender domain must be verified in your Resend account.
RESEND_FROM="Influency English Billing <billing@influenceyenglish.com>"
