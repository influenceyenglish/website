# Copy to .env.local. All credential values must be filled in your own environment.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
APP_URL=http://localhost:3000
RAZORPAY_MODE=test
RAZORPAY_ENABLE_LIVE=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Optional secret rotation: retain the previous secret while Razorpay retries old events.
RAZORPAY_PREVIOUS_WEBHOOK_SECRET=
# Create Test Mode plans: monthly INR 49900 paise; yearly INR 478800 paise; interval 1.
RAZORPAY_MONTHLY_PLAN_ID=
RAZORPAY_YEARLY_PLAN_ID=
# Postgres connection string. Use the provider's TLS-enabled URL in hosted environments.
DATABASE_URL=
